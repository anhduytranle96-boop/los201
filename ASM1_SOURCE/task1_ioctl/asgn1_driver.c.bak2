#include <linux/module.h>
#include <linux/kernel.h>
#include <linux/fs.h>
#include <linux/uaccess.h>
#include <linux/cdev.h>
#include <linux/device.h>
#include <linux/proc_fs.h>
#include <linux/seq_file.h>
#include <linux/slab.h>
#include <linux/mutex.h>
#include <linux/sysfs.h>
#include "asgn1_ioctl.h"

MODULE_LICENSE("GPL");
MODULE_AUTHOR("Embedded Linux Lab");
MODULE_DESCRIPTION("LAB-02: Simple Character Device Driver");
MODULE_VERSION("1.0");
#define DEVICE_NAME "asgn1"
#define CLASS_NAME "asgn1_class"
#define BUFFER_SIZE 1024
#define DRIVER_MAJOR 240

static int major_number = DRIVER_MAJOR;
static char device_buffer[BUFFER_SIZE];
static int buffer_len = 0;

static int open_count = 0;
static int write_count = 0;
static int read_count = 0;
static int last_write_size = 0;

/* Default: Echo mode */
static int write_mode = 1;

static struct class *lab2_class = NULL;
static struct device *lab2_device = NULL;

static DEFINE_MUTEX(lab2_mutex);

/* =========================================================
 * PROCFS IMPLEMENTATION
 * ========================================================= */

static struct proc_dir_entry *proc_entry;

static int lab2_proc_show(struct seq_file *m, void *v)
{
    seq_printf(m, "LAB-02 Driver Statistics\n");
    seq_printf(m, "======================\n");
    seq_printf(m, "Driver name : %s\n", DEVICE_NAME);
    seq_printf(m, "Major number : %d\n", major_number);
    seq_printf(m, "Buffer size : %d bytes\n", BUFFER_SIZE);
    seq_printf(m, "Data length : %d bytes\n", buffer_len);
    seq_printf(m, "Open count : %d\n", open_count);

    if (buffer_len > 0)
        seq_printf(m, "Last data : [%s]\n", device_buffer);

    return 0;
}

static int lab2_proc_open(struct inode *inode, struct file *file)
{
    return single_open(file, lab2_proc_show, NULL);
}

static const struct proc_ops lab2_proc_fops = {
    .proc_open = lab2_proc_open,
    .proc_read = seq_read,
    .proc_lseek = seq_lseek,
    .proc_release = single_release,
};

/* =========================================================
 * SYSFS IMPLEMENTATION
 * ========================================================= */

static ssize_t buffer_len_show(struct device *dev,
                               struct device_attribute *attr,
                               char *buf)
{
    return sprintf(buf, "%d\n", buffer_len);
}

static ssize_t open_count_show(struct device *dev,
                               struct device_attribute *attr,
                               char *buf)
{
    return sprintf(buf, "%d\n", open_count);
}

static ssize_t last_data_show(struct device *dev,
                              struct device_attribute *attr,
                              char *buf)
{
    if (buffer_len > 0)
        return sprintf(buf, "%s\n", device_buffer);

    return sprintf(buf, "(empty)\n");
}

static DEVICE_ATTR_RO(buffer_len);
static DEVICE_ATTR_RO(open_count);
static DEVICE_ATTR_RO(last_data);

static struct attribute *lab2_attrs[] = {
    &dev_attr_buffer_len.attr,
    &dev_attr_open_count.attr,
    &dev_attr_last_data.attr,
    NULL,
};

static struct attribute_group lab2_attr_group = {
    .attrs = lab2_attrs,
};

/* =========================================================
 * CHARACTER DEVICE OPERATIONS
 * ========================================================= */

static int lab2_open(struct inode *inode, struct file *file)
{
    mutex_lock(&lab2_mutex);

    open_count++;

    mutex_unlock(&lab2_mutex);

    pr_info("lab2_driver: device opened (count=%d)\n",
            open_count);

    return 0;
}

static int lab2_release(struct inode *inode, struct file *file)
{
    pr_info("lab2_driver: device closed\n");

    return 0;
}
static ssize_t lab2_read(struct file *file,
                         char __user *buf,
                         size_t count,
                         loff_t *offset)
{
    size_t available;
    size_t len;

    if (count == 0)
        return 0;

    mutex_lock(&lab2_mutex);

    if (*offset < 0 || (size_t)*offset >= buffer_len) {
        mutex_unlock(&lab2_mutex);
        return 0;
    }

    available = buffer_len - (size_t)*offset;
    len = min(count, available);

    if (copy_to_user(buf, device_buffer + *offset, len)) {
        mutex_unlock(&lab2_mutex);
        return -EFAULT;
    }

    *offset += len;
    read_count++;

    mutex_unlock(&lab2_mutex);

    pr_info("asgn1_driver: sent %zu bytes to user\n", len);

    return (ssize_t)len;
}


static ssize_t lab2_write(struct file *file,
                          const char __user *buf,
                          size_t len,
                          loff_t *offset)
{
    char temp[BUFFER_SIZE];
    size_t prefix_len = 0;
    size_t data_len;
    size_t total_len;
    int current_mode;

    if (len == 0)
        return 0;

    if (len >= BUFFER_SIZE)
        return -EINVAL;

    if (copy_from_user(temp, buf, len))
        return -EFAULT;

    temp[len] = '\0';

    mutex_lock(&lab2_mutex);
    current_mode = write_mode;

    if (current_mode == 0) {
        prefix_len = strlen("[KERNEL]");
        data_len = len;

        if (prefix_len + data_len >= BUFFER_SIZE) {
            mutex_unlock(&lab2_mutex);
            return -ENOSPC;
        }

        memcpy(device_buffer, "[KERNEL]", prefix_len);
        memcpy(device_buffer + prefix_len, temp, data_len);
        total_len = prefix_len + data_len;
    } else {
        data_len = len;
        memcpy(device_buffer, temp, data_len);
        total_len = data_len;
    }

    device_buffer[total_len] = '\0';
    buffer_len = total_len;

    write_count++;
    last_write_size = len;

    mutex_unlock(&lab2_mutex);

    pr_info("asgn1_driver: received %zu bytes, mode=%d\n",
            len, current_mode);

    return len;
}
static long asgn1_ioctl(struct file *file,
                        unsigned int cmd,
                        unsigned long arg)
{
    int mode;
    struct asgn1_stats stats;
    char version[64] = "ASGN1 Driver Version 1.0";

    switch (cmd) {
    case ASGN1_RESET_BUFFER:
        mutex_lock(&lab2_mutex);

        memset(device_buffer, 0, sizeof(device_buffer));
        buffer_len = 0;
        write_count = 0;
        read_count = 0;
        last_write_size = 0;

        mutex_unlock(&lab2_mutex);

        pr_info("asgn1_driver: ASGN1_RESET_BUFFER called\n");
        return 0;

    case ASGN1_GET_STATS:
        mutex_lock(&lab2_mutex);

        stats.open_count = open_count;
        stats.write_count = write_count;
        stats.read_count = read_count;
        stats.buffer_len = buffer_len;
        stats.last_write_size = last_write_size;

        mutex_unlock(&lab2_mutex);

        pr_info("asgn1_driver: ASGN1_GET_STATS called\n");

        if (copy_to_user((void __user *)arg, &stats, sizeof(stats)))
            return -EFAULT;

        return 0;

    case ASGN1_SET_MODE:
        if (copy_from_user(&mode, (int __user *)arg, sizeof(mode)))
            return -EFAULT;

        if (mode != 0 && mode != 1)
            return -EINVAL;

        mutex_lock(&lab2_mutex);
        write_mode = mode;
        mutex_unlock(&lab2_mutex);

        pr_info("asgn1_driver: ASGN1_SET_MODE called, mode=%d\n", mode);
        return 0;

    case ASGN1_GET_VERSION:
        pr_info("asgn1_driver: ASGN1_GET_VERSION called\n");

        if (copy_to_user((void __user *)arg, version, sizeof(version)))
            return -EFAULT;

        return 0;

    default:
        pr_warn("asgn1_driver: unknown ioctl command 0x%x\n", cmd);
        return -ENOTTY;
    }
}
static struct file_operations lab2_fops = {
    .owner = THIS_MODULE,
    .open = lab2_open,
    .release = lab2_release,
    .read = lab2_read,
    .write = lab2_write,
    .unlocked_ioctl = asgn1_ioctl,
};

/* =========================================================
 * MODULE INIT
 * ========================================================= */

static int __init lab2_init(void)
{
    int ret;

    pr_info("lab2_driver: initializing module\n");

    /*
     * Đăng ký character device với major number cố định 240.
     */
    ret = register_chrdev(major_number,
                          DEVICE_NAME,
                          &lab2_fops);

    if (ret < 0) {
        pr_err("lab2_driver: register_chrdev failed: %d\n",
               ret);
        return ret;
    }

    /*
     * Tạo class trong sysfs:
     * /sys/class/lab2_class/
     */
    lab2_class = class_create(THIS_MODULE,
                              CLASS_NAME);

    if (IS_ERR(lab2_class)) {
        unregister_chrdev(major_number,
                          DEVICE_NAME);

        return PTR_ERR(lab2_class);
    }

    /*
     * Tạo device:
     * /sys/class/lab2_class/lab2
     */
    lab2_device = device_create(
        lab2_class,
        NULL,
        MKDEV(major_number, 0),
        NULL,
        DEVICE_NAME
    );

    if (IS_ERR(lab2_device)) {
        class_destroy(lab2_class);

        unregister_chrdev(major_number,
                          DEVICE_NAME);

        return PTR_ERR(lab2_device);
    }

    /*
     * Đăng ký nhóm sysfs attributes:
     * buffer_len
     * open_count
     * last_data
     */
    ret = sysfs_create_group(&lab2_device->kobj,
                             &lab2_attr_group);

    if (ret)
        pr_warn("lab2_driver: sysfs_create_group failed\n");

    /*
     * Tạo procfs entry:
     * /proc/lab2_info
     *
     * seq_file giúp xuất text từ kernel ra userspace
     * an toàn và thuận tiện.
     */
    proc_entry = proc_create("lab2_info",
                             0444,
                             NULL,
                             &lab2_proc_fops);

    if (!proc_entry) {
        pr_warn("lab2_driver: failed to create /proc/lab2_info\n");
    } else {
        pr_info("lab2_driver: /proc/lab2_info created\n");
    }

    pr_info("lab2_driver: loaded, major=%d\n",
            major_number);

    return 0;
}

/* =========================================================
 * MODULE EXIT
 * ========================================================= */

static void __exit lab2_exit(void)
{
    /*
     * Xóa procfs entry.
     */
    if (proc_entry)
        proc_remove(proc_entry);

    /*
     * Xóa sysfs attributes.
     */
    sysfs_remove_group(&lab2_device->kobj,
                       &lab2_attr_group);

    /*
     * Xóa device và class.
     */
    device_destroy(lab2_class,
                   MKDEV(major_number, 0));

    class_destroy(lab2_class);

    /*
     * Hủy đăng ký character device.
     */
    unregister_chrdev(major_number,
                      DEVICE_NAME);

    pr_info("lab2_driver: module unloaded\n");
}

module_init(lab2_init);
module_exit(lab2_exit);
